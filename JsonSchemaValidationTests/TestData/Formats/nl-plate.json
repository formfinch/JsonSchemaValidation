[
    {
        "description": "validation of nl-plate",
        "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "format": "nl-plate"
        },
        "tests": [
            {
                "description": "sidecode 1",
                "data": "AB-12-34",
                "valid": true
            },
            {
                "description": "sidecode 2",
                "data": "12-34-AB",
                "valid": true
            },
            {
                "description": "sidecode 3",
                "data": "12-AB-34",
                "valid": true
            },
            {
                "description": "sidecode 4",
                "data": "AB-12-CD",
                "valid": true
            },
            {
                "description": "sidecode 5",
                "data": "AB-CD-12",
                "valid": true
            },
            {
                "description": "sidecode 6",
                "data": "12-AB-CD",
                "valid": true
            },
            {
                "description": "sidecode 7",
                "data": "12-ABC-3",
                "valid": true
            },
            {
                "description": "sidecode 8",
                "data": "1-ABC-23",
                "valid": true
            },
            {
                "description": "sidecode 9",
                "data": "AB-123-C",
                "valid": true
            },
            {
                "description": "sidecode 10",
                "data": "A-123-BC",
                "valid": true
            },
            {
                "description": "sidecode 11",
                "data": "ABC-12-D",
                "valid": true
            },
            {
                "description": "sidecode 12",
                "data": "A-12-BCD",
                "valid": true
            },
            {
                "description": "sidecode 13",
                "data": "1-AB-234",
                "valid": true
            },
            {
                "description": "sidecode 14",
                "data": "123-AB-4",
                "valid": true
            },
            {
                "description": "lower case without hyphens",
                "data": "ab12cd",
                "valid": true
            },
            {
                "description": "spaces",
                "data": "12 ABC 3",
                "valid": true
            },
            {
                "description": "LLLDDD is not a sidecode",
                "data": "ABC-123",
                "valid": false
            },
            {
                "description": "DDDLLL is not a sidecode",
                "data": "123-ABC",
                "valid": false
            },
            {
                "description": "5 characters",
                "data": "AB-12-3",
                "valid": false
            },
            {
                "description": "7 characters",
                "data": "AB-12-345",
                "valid": false
            },
            {
                "description": "alternating pattern",
                "data": "A1-B2-C3",
                "valid": false
            },
            {
                "description": "letters only",
                "data": "ABCDEF",
                "valid": false
            },
            {
                "description": "digits only",
                "data": "123456",
                "valid": false
            },
            {
                "description": "underscore",
                "data": "12-AB_34",
                "valid": false
            },
            {
                "description": "dots",
                "data": "AB.12.CD",
                "valid": false
            },
            {
                "description": "empty string",
                "data": "",
                "valid": false
            },
            {
                "description": "non-string instances are ignored",
                "data": 12345,
                "valid": true
            },
            {
                "description": "null is ignored",
                "data": null,
                "valid": true
            }
        ]
    }
]
