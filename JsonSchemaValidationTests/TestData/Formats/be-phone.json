[
    {
        "description": "validation of be-phone",
        "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "format": "be-phone"
        },
        "tests": [
            {
                "description": "mobile grouped",
                "data": "0475 12 34 56",
                "valid": true
            },
            {
                "description": "mobile with slash and dots",
                "data": "0475/12.34.56",
                "valid": true
            },
            {
                "description": "international mobile",
                "data": "+32 475 12 34 56",
                "valid": true
            },
            {
                "description": "00 prefix",
                "data": "0032 475 12 34 56",
                "valid": true
            },
            {
                "description": "international with (0)",
                "data": "+32 (0)475 12 34 56",
                "valid": true
            },
            {
                "description": "Brussels landline",
                "data": "02 123 45 67",
                "valid": true
            },
            {
                "description": "international landline",
                "data": "+32 2 123 45 67",
                "valid": true
            },
            {
                "description": "mobile 046x",
                "data": "0468 12 34 56",
                "valid": true
            },
            {
                "description": "no prefix",
                "data": "475123456",
                "valid": false
            },
            {
                "description": "9 digits outside the mobile ranges",
                "data": "0445 12 34 56",
                "valid": false
            },
            {
                "description": "too many digits",
                "data": "0475 12 34 567",
                "valid": false
            },
            {
                "description": "too few digits",
                "data": "02 123 456",
                "valid": false
            },
            {
                "description": "Dutch number",
                "data": "+31 6 12345678",
                "valid": false
            },
            {
                "description": "letters",
                "data": "0475 12 34 5x",
                "valid": false
            },
            {
                "description": "empty string",
                "data": "",
                "valid": false
            },
            {
                "description": "non-string instances are ignored",
                "data": 12345,
                "valid": true
            },
            {
                "description": "null is ignored",
                "data": null,
                "valid": true
            }
        ]
    }
]
